---
/**
 * Shell for the marketing pages.
 *
 * Starlight owns everything under /docs; this layout owns the landing of each
 * locale, so it carries its own head, header and footer — and the hreflang set
 * that ties the three locales together for search engines.
 */
import '../styles/theme.css'

import Footer from '../components/landing/Footer.astro'
import Header from '../components/landing/Header.astro'
import { LOCALE_META, UI, homeOf, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  title: string
  description: string
}

const { locale, title, description } = Astro.props
const meta = LOCALE_META[locale]
const ui = UI[locale]
const site = Astro.site ?? new URL('https://sparquet.dev')
const canonical = new URL(homeOf(locale), site)
const ogImage = new URL('/og.png', site)
---

<!doctype html>
<html lang={meta.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0d" />

    {
      (['en', 'pt', 'es'] as Locale[]).map((code) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[code].hreflang}
          href={new URL(homeOf(code), site).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sparquet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content={meta.htmlLang.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Sparquet',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Any',
        description,
        url: canonical.href,
        license: 'https://opensource.org/licenses/MIT',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
  </head>

  <body class="landing">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink-950"
    >
      {ui.nav.skipToContent}
    </a>

    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
