---
/**
 * Docs site title. Links back to the landing page of the current locale instead
 * of the docs index, so the mark behaves the way it does on every marketing page.
 */
import logo from '../../assets/logo.svg'

const lang = Astro.currentLocale ?? 'en'
const home = lang === 'en' ? '/' : `/${lang.split('-')[0]}/`
---

<a href={home} class="site-title sl-flex">
  <img src={logo.src} alt="" width="28" height="28" />
  <span>Sparquet</span>
</a>

<style>
  a {
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h4);
    text-decoration: none;
    white-space: nowrap;
  }

  img {
    border-radius: 6px;
  }
</style>
