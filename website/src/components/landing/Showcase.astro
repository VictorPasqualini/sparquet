---
/**
 * Studio, connectors, the assistant and the runtimes — the four sections that
 * answer "what does this actually look like, and will it fit my stack?".
 */
import { Image } from 'astro:assets'

import studioShot from '../../assets/screens/editor.png'
import { LANDING } from '../../i18n/landing'
import { docsOf, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = LANDING[locale]

const FILE_CONNECTORS = [
  { name: 'Parquet', note: 'Spark native' },
  { name: 'Delta Lake', note: 'MERGE · time travel' },
  { name: 'Iceberg', note: 'MERGE INTO' },
  { name: 'CSV', note: 'header · inferSchema' },
  { name: 'Text', note: 'value column' },
  { name: 'Temp view', note: 'auto-cached' },
]

const LAKEHOUSE_FEATURES = [
  { name: 'MERGE upserts', note: 'delta · iceberg' },
  { name: 'Time travel', note: 'delta' },
  { name: 'Partitioned writes', note: 'file formats' },
  { name: 'Column projection', note: 'per destination' },
  { name: 'Custom connectors', note: 'register your own' },
]

const STREAM_CONNECTORS = [{ name: 'Kafka', note: 'batch publish' }]
---

<!-- ------------------------------------------------------------- studio -->
<section class="rule-top bg-ink-900/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <div>
        <p class="eyebrow">{copy.studio.eyebrow}</p>
        <h2
          class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
        >
          {copy.studio.title}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-ink-300">{copy.studio.body}</p>

        <ul class="mt-6 space-y-3">
          {
            copy.studio.bullets.map((bullet) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink-300">
                <svg
                  viewBox="0 0 20 20"
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-500"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8.2 13.4 5 10.2l1.4-1.4 1.8 1.8 5-5L14.6 7l-6.4 6.4Z" />
                  <path
                    d="M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm0 15.3a6.8 6.8 0 1 1 0-13.6 6.8 6.8 0 0 1 0 13.6Z"
                    opacity=".45"
                  />
                </svg>
                {bullet}
              </li>
            ))
          }
        </ul>

        <a
          href={docsOf(locale, 'studio/')}
          class="mt-7 inline-block rounded-xl border border-white/12 px-5 py-3 text-sm font-medium text-ink-200 transition-colors hover:border-brand-500/50 hover:text-white"
        >
          {copy.studio.cta}
        </a>
      </div>

      <figure class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/50">
        <Image
          src={studioShot}
          alt={copy.studio.imageAlt}
          widths={[720, 1080, 1512]}
          sizes="(min-width: 1024px) 640px, 100vw"
          loading="lazy"
          class="w-full"
        />
      </figure>
    </div>
  </div>
</section>

<!-- --------------------------------------------------------- connectors -->
<section class="mx-auto max-w-6xl px-5 py-20 md:py-24">
  <div class="max-w-2xl">
    <p class="eyebrow">{copy.connectors.eyebrow}</p>
    <h2
      class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      {copy.connectors.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-300">{copy.connectors.body}</p>
  </div>

  <div class="mt-10 grid gap-8 md:grid-cols-2">
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-500">
        {copy.connectors.readWrite}
      </h3>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          FILE_CONNECTORS.map((connector) => (
            <li class="card-surface flex items-baseline justify-between gap-3 px-4 py-3">
              <span class="text-sm font-medium text-white">{connector.name}</span>
              <span class="font-mono text-[0.65rem] text-ink-500">{connector.note}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-6 text-xs font-semibold uppercase tracking-wider text-ink-500">
        {copy.connectors.writeOnly}
      </h3>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          STREAM_CONNECTORS.map((connector) => (
            <li class="card-surface flex items-baseline justify-between gap-3 px-4 py-3">
              <span class="text-sm font-medium text-white">{connector.name}</span>
              <span class="font-mono text-[0.65rem] text-ink-500">{connector.note}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-500">
        {copy.connectors.lakehouse}
      </h3>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          LAKEHOUSE_FEATURES.map((connector) => (
            <li class="card-surface flex items-baseline justify-between gap-3 px-4 py-3">
              <span class="text-sm font-medium text-white">{connector.name}</span>
              <span class="font-mono text-[0.65rem] text-ink-500">{connector.note}</span>
            </li>
          ))
        }
      </ul>

      <div class="card-surface mt-4 p-4">
        <pre class="overflow-x-auto font-mono text-[0.7rem] leading-relaxed text-ink-300"><code>{`{
  "format": "delta",
  "path": "analytics.orders",
  "mode": "merge",
  "options": {
    "merge_keys": ["order_id"],
    "merge_condition": "T.deleted = false"
  }
}`}</code></pre>
      </div>

      <a
        href={docsOf(locale, 'reference/connectors/')}
        class="mt-4 inline-block text-sm font-medium text-brand-400 underline-offset-4 hover:underline"
      >
        {copy.connectors.cta} →
      </a>
    </div>
  </div>
</section>

<!-- ------------------------------------------------------------------ ai -->
<section class="rule-top bg-ink-900/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{copy.ai.eyebrow}</p>
        <h2
          class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
        >
          {copy.ai.title}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-ink-300">{copy.ai.body}</p>

        <ul class="mt-6 space-y-2.5">
          {
            copy.ai.bullets.map((bullet) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink-300">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brand-500" />
                {bullet}
              </li>
            ))
          }
        </ul>

        <a
          href={docsOf(locale, 'studio/ai-assistant/')}
          class="mt-7 inline-block text-sm font-medium text-brand-400 underline-offset-4 hover:underline"
        >
          {copy.ai.cta} →
        </a>
      </div>

      <div class="card-surface p-5">
        <div class="flex items-start gap-3">
          <span
            class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-white/8 text-xs text-ink-300"
          >
            You
          </span>
          <p class="text-sm leading-relaxed text-ink-200">{copy.ai.prompt}</p>
        </div>

        <div class="mt-5 flex items-start gap-3">
          <span
            class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-500/15 text-brand-400"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2.6 13.7 8l5.4 1.7-5.4 1.7L12 16.8 10.3 11.4 4.9 9.7 10.3 8 12 2.6ZM18.5 15l.8 2.6 2.7.9-2.7.9-.8 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6Z"
              ></path>
            </svg>
          </span>
          <div class="min-w-0 flex-1">
            <div class="rounded-xl border border-brand-500/25 bg-brand-500/8 p-3">
              <p class="text-sm font-medium text-white">{copy.ai.answer}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-lg bg-brand-500 px-2.5 py-1 text-xs font-semibold text-ink-950">
                  Apply to canvas
                </span>
                <span class="rounded-lg border border-white/12 px-2.5 py-1 text-xs text-ink-300">
                  View JSON
                </span>
              </div>
            </div>
            <p class="mt-2 font-mono text-[0.65rem] text-ink-500">
              anthropic · openai · google · openai-compatible
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ---------------------------------------------------------------- runs -->
<section class="mx-auto max-w-6xl px-5 py-20 md:py-24">
  <div class="max-w-2xl">
    <p class="eyebrow">{copy.runs.eyebrow}</p>
    <h2
      class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      {copy.runs.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-300">{copy.runs.body}</p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      copy.runs.targets.map((target) => (
        <div class="card-surface p-5">
          <h3 class="text-[0.95rem] font-semibold text-white">{target.name}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-400">{target.body}</p>
        </div>
      ))
    }
  </div>
</section>
