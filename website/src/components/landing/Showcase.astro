---
/**
 * Studio, the assistant, the connector surface and the runtimes — the sections
 * that answer "what does this look like, and will it fit my stack?".
 */
import { Image } from 'astro:assets'

import studioShot from '../../assets/screens/editor.png'
import { LANDING } from '../../i18n/landing'
import { docsOf, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = LANDING[locale]

/** Typed out by the assistant demo once the section scrolls into view. */
const generated = `{
  "input":  { "format": "delta", "path": "sales.orders" },
  "transformations": [
    { "type": "filter", "condition": "status = 'CONFIRMED'" },
    { "type": "drop_duplicates", "columns": ["id"] },
    { "type": "group_by", "by": ["customer_id"],
      "agg": ["sum(revenue) as revenue"] }
  ],
  "validations": {
    "on_failure": "fail",
    "rules": [{ "type": "not_null", "columns": ["id"] }]
  },
  "output": {
    "format": "delta", "path": "analytics.customer_revenue",
    "mode": "merge", "options": { "merge_keys": ["customer_id"] }
  }
}`

const totalConnectors = copy.connectors.groups.reduce(
  (total, group) => total + group.items.length,
  0,
)
---

<!-- ------------------------------------------------------------- studio -->
<section class="rule-top bg-ink-900/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <div class="reveal">
        <p class="eyebrow">{copy.studio.eyebrow}</p>
        <h2
          class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
        >
          {copy.studio.title}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-ink-300">{copy.studio.body}</p>

        <dl class="mt-6 space-y-2.5 border-l border-brand-500/25 pl-4">
          {
            copy.studio.vocabulary.map((entry) => (
              <div class="text-sm leading-relaxed">
                <dt class="inline font-semibold text-white">{entry.term}</dt>
                <dd class="inline text-ink-400">, {entry.body}</dd>
              </div>
            ))
          }
        </dl>

        <ul class="mt-6 space-y-3">
          {
            copy.studio.bullets.map((bullet) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink-300">
                <svg
                  viewBox="0 0 20 20"
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-500"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8.2 13.4 5 10.2l1.4-1.4 1.8 1.8 5-5L14.6 7l-6.4 6.4Z" />
                  <path
                    d="M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm0 15.3a6.8 6.8 0 1 1 0-13.6 6.8 6.8 0 0 1 0 13.6Z"
                    opacity=".45"
                  />
                </svg>
                {bullet}
              </li>
            ))
          }
        </ul>

        <a
          href={docsOf(locale, 'studio/')}
          class="mt-7 inline-block rounded-xl border border-white/12 px-5 py-3 text-sm font-medium text-ink-200 transition-colors hover:border-brand-500/50 hover:text-white"
        >
          {copy.studio.cta}
        </a>
      </div>

      <figure
        class="reveal spotlight overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/50"
        style="--reveal-delay: 120ms"
      >
        <Image
          src={studioShot}
          alt={copy.studio.imageAlt}
          widths={[720, 1080, 1512]}
          sizes="(min-width: 1024px) 640px, 100vw"
          loading="lazy"
          class="w-full"
        />
      </figure>
    </div>
  </div>
</section>

<!-- ------------------------------------------------------------------ ai -->
<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">{copy.ai.eyebrow}</p>
        <h2
          class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
        >
          {copy.ai.title}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-ink-300">{copy.ai.body}</p>

        <ul class="mt-6 space-y-2.5">
          {
            copy.ai.bullets.map((bullet) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink-300">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brand-500" />
                {bullet}
              </li>
            ))
          }
        </ul>

        <a
          href={docsOf(locale, 'studio/ai-assistant/')}
          class="mt-7 inline-block text-sm font-medium text-brand-400 underline-offset-4 hover:underline"
        >
          {copy.ai.cta} →
        </a>
      </div>

      <div class="reveal card-surface spotlight p-5" style="--reveal-delay: 100ms">
        <div class="flex items-start gap-3">
          <span
            class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-white/8 text-xs text-ink-300"
          >
            You
          </span>
          <p class="text-sm leading-relaxed text-ink-200">{copy.ai.prompt}</p>
        </div>

        <div class="mt-5 flex items-start gap-3">
          <span
            class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-500/15 text-brand-400"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2.6 13.7 8l5.4 1.7-5.4 1.7L12 16.8 10.3 11.4 4.9 9.7 10.3 8 12 2.6ZM18.5 15l.8 2.6 2.7.9-2.7.9-.8 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6Z"
              ></path>
            </svg>
          </span>

          <div class="min-w-0 flex-1">
            <div
              class="overflow-hidden rounded-xl border border-brand-500/25 bg-ink-950/70"
              data-stream-root
            >
              <div
                class="flex items-center justify-between border-b border-white/8 px-3 py-1.5 font-mono text-[0.62rem] text-ink-500"
              >
                <span>orders_curated.json</span>
                <span data-stream-status>generating…</span>
              </div>
              <pre
                class="max-h-64 overflow-hidden px-3 py-2.5 font-mono text-[0.65rem] leading-relaxed text-ink-300"><code
                  class="caret"
                  data-stream-target
                  data-stream-text={generated}></code></pre>
            </div>

            <div class="mt-3 rounded-xl border border-brand-500/25 bg-brand-500/8 p-3">
              <p class="text-sm font-medium text-white">{copy.ai.answer}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-lg bg-brand-500 px-2.5 py-1 text-xs font-semibold text-ink-950">
                  Apply to canvas
                </span>
                <span class="rounded-lg border border-white/12 px-2.5 py-1 text-xs text-ink-300">
                  View JSON
                </span>
              </div>
            </div>

            <p class="mt-2 font-mono text-[0.65rem] text-ink-500">
              anthropic · openai · google · openai-compatible
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- --------------------------------------------------------- connectors -->
<section class="rule-top bg-ink-900/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{copy.connectors.eyebrow}</p>
      <h2
        class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
      >
        {copy.connectors.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-300">{copy.connectors.body}</p>
    </div>

    <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.connectors.groups.map((group, index) => (
          <div class="reveal" style={`--reveal-delay: ${(index % 3) * 80}ms`}>
            <div class="flex items-baseline justify-between">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-500">
                {group.label}
              </h3>
              <span class="font-mono text-[0.62rem] text-ink-600">{group.items.length}</span>
            </div>
            <div class="mt-2 h-px w-full bg-white/8">
              <div class="rule-draw h-px w-full bg-brand-500/40" />
            </div>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="rounded-lg border border-white/8 bg-ink-900/60 px-2.5 py-1 text-xs text-ink-300 transition-colors hover:border-brand-500/40 hover:text-white">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="reveal mt-10 flex flex-wrap items-center gap-3 text-sm">
      <span class="font-mono text-ink-500">{totalConnectors} total</span>
      <a
        href={docsOf(locale, 'reference/connectors/')}
        class="font-medium text-brand-400 underline-offset-4 hover:underline"
      >
        {copy.connectors.cta} →
      </a>
    </p>
  </div>
</section>

<!-- ---------------------------------------------------------------- runs -->
<section class="mx-auto max-w-6xl px-5 py-20 md:py-24">
  <div class="reveal max-w-2xl">
    <p class="eyebrow">{copy.runs.eyebrow}</p>
    <h2
      class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      {copy.runs.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-300">{copy.runs.body}</p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      copy.runs.targets.map((target, index) => (
        <div
          class="reveal card-surface spotlight p-5"
          style={`--reveal-delay: ${(index % 4) * 70}ms`}
        >
          <h3 class="text-[0.95rem] font-semibold text-white">{target.name}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-400">{target.body}</p>
        </div>
      ))
    }
  </div>
</section>
