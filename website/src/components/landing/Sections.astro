---
/**
 * The argument: why a standard, how you author one, and what it covers.
 * They share one file because they share one rhythm — eyebrow, heading, body,
 * grid — and splitting that rhythm across files only makes it harder to keep.
 */
import { LANDING } from '../../i18n/landing'
import { docsOf, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = LANDING[locale]

/** One glyph per authoring path, in the order the section presents them. */
const WAY_ICONS = [
  'M8 6h8M8 10h8M8 14h5M5 3h14v18H5z',
  'M12 3.2 13.4 8 18 9.4 13.4 10.8 12 15.6 10.6 10.8 6 9.4 10.6 8 12 3.2ZM17.5 15l.8 2.3 2.4.8-2.4.8-.8 2.3-.8-2.3-2.4-.8 2.4-.8.8-2.3Z',
  'M4 7h5v4H4zM15 4h5v4h-5zM15 13h5v7h-5zM9 9h6M9 9v7.5h6',
]

const FEATURE_ICONS = [
  'M4 7h16M4 12h10M4 17h6',
  'M12 3l7 4v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V7l7-4Zm-1.2 11.4 5-5-1.4-1.4-3.6 3.6-1.6-1.6L7.8 12l3 2.4Z',
  'M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3Zm8 6.5V12c0 1.7-3.6 3-8 3s-8-1.3-8-3V9.5c1.6 1.2 4.6 1.8 8 1.8s6.4-.6 8-1.8ZM20 15v2c0 1.7-3.6 3-8 3s-8-1.3-8-3v-2c1.6 1.2 4.6 1.8 8 1.8s6.4-.6 8-1.8Z',
  'M5 5h14v6H5zM5 15h6v4H5zM13 15h6v4h-6ZM9 11v4M15 11v4',
  'M7 4h10v2.6L13 12l4 5.4V20H7v-2.6L11 12 7 6.6V4Z',
  'M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 20h16',
  'M5 12h5m0 0 4-6h5m-9 6 4 6h5',
  'M11 3h2v5h5v2h-5v5h-2v-5H6V8h5V3Zm-5 13h12v5H6v-5Z',
]

/** Miniature of what each authoring path looks like in practice. */
const WAY_PREVIEWS = [
  ['{ "type": "filter",', '  "condition": "status = ..." }'],
  ['keep confirmed orders,', 'upsert revenue per customer'],
  ['Delta → Filter → Validations', '→ Delta (merge)'],
]
---

<!-- ------------------------------------------------------------- problem -->
<section class="mx-auto max-w-6xl px-5 py-20 md:py-24">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">{copy.problem.eyebrow}</p>
      <h2
        class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
      >
        {copy.problem.title}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-ink-300">{copy.problem.body}</p>
    </div>

    <ul class="space-y-4">
      {
        copy.problem.points.map((point, index) => (
          <li
            class="reveal card-surface spotlight p-5 transition-colors"
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-xs text-brand-500">{`0${index + 1}`}</span>
              <div>
                <h3 class="text-[0.95rem] font-semibold text-white">{point.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-400">{point.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ---------------------------------------------------------------- ways -->
<section class="rule-top relative overflow-hidden bg-ink-900/40">
  <div class="grid-surface absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{copy.ways.eyebrow}</p>
      <h2
        class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
      >
        {copy.ways.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-300">{copy.ways.subtitle}</p>
    </div>

    <ol class="mt-12 grid gap-4 md:grid-cols-3">
      {
        copy.ways.items.map((item, index) => (
          <li
            class="reveal card-surface spotlight flex flex-col p-5"
            style={`--reveal-delay: ${index * 110}ms`}
          >
            <div class="flex items-center justify-between">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-brand-500/30 bg-brand-500/10 text-brand-400">
                <svg
                  viewBox="0 0 24 24"
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={WAY_ICONS[index % WAY_ICONS.length]} />
                </svg>
              </div>
              <span class="font-mono text-xs text-ink-600">{item.step}</span>
            </div>

            <h3 class="mt-4 text-lg font-semibold text-white">{item.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-400">{item.body}</p>

            <div class="mt-5 rounded-lg border border-white/8 bg-ink-950/60 px-3 py-2.5">
              <p class="text-[0.6rem] uppercase tracking-wider text-ink-600">{item.caption}</p>
              <div class="mt-1.5 space-y-0.5 font-mono text-[0.65rem] leading-relaxed text-ink-400">
                {(WAY_PREVIEWS[index] ?? []).map((line) => (
                  <p class="truncate">{line}</p>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-8 text-sm text-ink-500">{copy.ways.footnote}</p>
  </div>
</section>

<!-- --------------------------------------------------------- features -->
<section class="mx-auto max-w-6xl px-5 py-20 md:py-24">
  <div class="reveal max-w-2xl">
    <p class="eyebrow">{copy.features.eyebrow}</p>
    <h2
      class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      {copy.features.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-300">{copy.features.subtitle}</p>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      copy.features.items.map((item, index) => (
        <article
          class="reveal card-surface spotlight p-5 transition-colors"
          style={`--reveal-delay: ${(index % 4) * 70}ms`}
        >
          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5 text-brand-500"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={FEATURE_ICONS[index % FEATURE_ICONS.length]} />
          </svg>
          <h3 class="mt-3.5 text-[0.95rem] font-semibold text-white">{item.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-400">{item.body}</p>
        </article>
      ))
    }
  </div>

  <p class="reveal mt-8 text-sm">
    <a
      href={docsOf(locale, 'reference/pipeline-json/')}
      class="font-medium text-brand-400 underline-offset-4 hover:underline"
    >
      {copy.features.cta} →
    </a>
  </p>
</section>
