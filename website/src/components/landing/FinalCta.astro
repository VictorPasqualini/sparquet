---
import { LANDING } from '../../i18n/landing'
import { GITHUB_URL, docsOf, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = LANDING[locale].cta
---

<section class="rule-top relative overflow-hidden bg-ink-900/40">
  <div class="glow-brand absolute inset-x-0 bottom-0 h-72 rotate-180" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-3xl px-5 py-20 text-center md:py-24">
    <h2
      class="text-balance text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl"
    >
      {copy.title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink-300">{copy.body}</p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={docsOf(locale, 'start/quickstart/')}
        class="rounded-xl bg-brand-500 px-5 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-brand-400"
      >
        {copy.primary}
      </a>
      <a
        href={GITHUB_URL}
        rel="noopener"
        class="rounded-xl border border-white/12 px-5 py-3 text-sm font-medium text-ink-200 transition-colors hover:border-white/25 hover:text-white"
      >
        {copy.secondary}
      </a>
    </div>

    <div
      class="mx-auto mt-8 flex max-w-sm items-center justify-between gap-3 rounded-xl border border-white/10 bg-ink-950 px-4 py-3"
    >
      <code class="font-mono text-sm text-ink-200">{copy.install}</code>
      <button
        type="button"
        data-copy={copy.install}
        class="rounded-lg border border-white/10 px-2.5 py-1 text-xs text-ink-400 transition-colors hover:border-white/25 hover:text-white"
      >
        copy
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copy
      if (!value) return
      try {
        await navigator.clipboard.writeText(value)
        const previous = button.textContent
        button.textContent = 'copied'
        setTimeout(() => {
          button.textContent = previous
        }, 1600)
      } catch {
        // Clipboard blocked (insecure context): leave the command on screen to select.
      }
    })
  })
</script>
