---
import logo from '../../assets/logo.svg'
import { GITHUB_URL, LOCALE_META, LOCALES, UI, docsOf, homeOf, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const ui = UI[locale]

const links = [
  { label: ui.nav.docs, href: docsOf(locale, 'start/') },
  { label: ui.nav.studio, href: docsOf(locale, 'studio/') },
  { label: ui.nav.connectors, href: docsOf(locale, 'reference/connectors/') },
  { label: ui.nav.reference, href: docsOf(locale, 'reference/pipeline-json/') },
]
---

<header class="sticky top-0 z-40 border-b border-white/8 bg-ink-950/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a
      href={homeOf(locale)}
      class="flex shrink-0 items-center gap-2.5 text-[0.95rem] font-semibold tracking-tight text-white"
    >
      <img src={logo.src} alt="" width="28" height="28" class="rounded-md" />
      Sparquet
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-1.5 text-sm text-ink-300 transition-colors hover:bg-white/5 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <label class="sr-only" for="locale-switcher">{ui.nav.language}</label>
      <select
        id="locale-switcher"
        class="cursor-pointer rounded-lg border border-white/10 bg-ink-900 px-2.5 py-1.5 text-xs text-ink-300 transition-colors hover:border-white/20 hover:text-white"
      >
        {
          LOCALES.map((code) => (
            <option value={homeOf(code)} selected={code === locale}>
              {LOCALE_META[code].label}
            </option>
          ))
        }
      </select>

      <a
        href={GITHUB_URL}
        rel="noopener"
        class="hidden rounded-lg border border-white/10 px-3 py-1.5 text-sm text-ink-300 transition-colors hover:border-white/20 hover:text-white sm:block"
      >
        {ui.nav.github}
      </a>

      <a
        href={docsOf(locale, 'start/quickstart/')}
        class="rounded-lg bg-brand-500 px-3.5 py-1.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-brand-400"
      >
        {ui.nav.getStarted}
      </a>
    </div>
  </div>
</header>

<script>
  const switcher = document.getElementById('locale-switcher')
  if (switcher instanceof HTMLSelectElement) {
    switcher.addEventListener('change', () => {
      window.location.href = switcher.value
    })
  }
</script>
