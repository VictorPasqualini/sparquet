{
  "name": "01_ingestao_validacoes",
  "description": "Ingestão básica: lê clientes em Parquet, limpa/normaliza, valida qualidade e grava processado. Demonstra filter, select, cast, rename, with_column, drop_duplicates e o bloco validations.",

  "input": {
    "format": "parquet",
    "path": "/data/raw/customers"
  },

  "transformations": [
    { "type": "filter", "condition": "status = 'active'" },
    { "type": "select", "columns": ["id", "name", "email", "age", "country", "created_at"] },
    { "type": "cast", "columns": { "age": "integer", "created_at": "timestamp" } },
    { "type": "rename", "mappings": { "created_at": "creation_date" } },
    { "type": "with_column", "column": "ingestion_ts", "expression": "current_timestamp()" },
    { "type": "drop_duplicates", "columns": ["id"] }
  ],

  "validations": {
    "on_failure": "fail",
    "rules": [
      { "type": "not_null", "columns": ["id", "email"] },
      { "type": "unique", "columns": ["id"] },
      { "type": "range", "column": "age", "min": 0, "max": 150 },
      { "type": "row_count", "min": 1 }
    ]
  },

  "output": {
    "format": "parquet",
    "path": "/data/processed/customers",
    "mode": "overwrite",
    "partition_by": ["country"]
  }
}
