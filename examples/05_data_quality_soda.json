{
  "name": "05_data_quality_soda",
  "description": "Qualidade de dados no estilo SODA Core + broadcast join. Enriquece pedidos com uma dimensão pequena (broadcast, map-side, sem shuffle) e valida a saída com checks baseados em métrica/threshold (warn/fail), configs de validade (valid_format), freshness e verificação de schema. O relatório de validações registra severity + metric_value.",
  "input": {
    "format": "delta",
    "path": "vendas.pedidos"
  },
  "transformations": [
    {
      "type": "join",
      "input": {
        "format": "delta",
        "path": "ref.dim_cliente"
      },
      "with_transformations": [
        {
          "type": "select",
          "columns": [
            "id_cliente",
            "segmento",
            "email"
          ]
        },
        {
          "type": "distinct"
        }
      ],
      "on": "id_cliente",
      "how": "left",
      "broadcast": true
    },
    {
      "type": "checkpoint"
    }
  ],
  "validations": {
    "on_failure": "warn",
    "report": {
      "format": "delta",
      "path": "dq.validation_report",
      "mode": "append"
    },
    "rules": [
      {
        "type": "row_count",
        "must_be": "> 0"
      },
      {
        "type": "missing_count",
        "name": "cliente sempre presente",
        "column": "id_cliente",
        "must_be": "= 0"
      },
      {
        "type": "missing_percent",
        "name": "email completo",
        "column": "email",
        "must_be": "< 5%",
        "warn": "= 0"
      },
      {
        "type": "invalid_percent",
        "name": "email válido",
        "column": "email",
        "valid_format": "email",
        "must_be": "< 5%"
      },
      {
        "type": "duplicate_count",
        "name": "sem pedido duplicado",
        "columns": [
          "id_pedido"
        ],
        "must_be": "= 0"
      },
      {
        "type": "avg",
        "name": "ticket médio plausível",
        "column": "valor",
        "must_be": "between 1 and 100000"
      },
      {
        "type": "freshness",
        "name": "dados frescos",
        "column": "dt_atualizacao",
        "must_be": "< 2d",
        "warn": "< 6h"
      },
      {
        "type": "schema",
        "required_columns": [
          "id_pedido",
          "id_cliente",
          "valor",
          "dt_atualizacao"
        ],
        "column_types": {
          "id_pedido": "bigint",
          "valor": "double"
        }
      }
    ]
  },
  "output": {
    "format": "delta",
    "path": "vendas.pedidos_enriquecidos",
    "mode": "overwrite"
  }
}
