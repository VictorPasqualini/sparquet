{
  "name": "formatos-parquet-escrita",
  "description": "Escreve o seed em parquet. Metade de ida do round-trip executado.",
  "input": {
    "format": "csv",
    "path": "{dir}/seed.csv",
    "options": {
      "header": "true",
      "inferSchema": "true"
    }
  },
  "transformations": [
    {
      "type": "filter",
      "condition": "valor IS NULL OR valor > -1000"
    }
  ],
  "output": {
    "format": "parquet",
    "path": "{dir}/out-parquet",
    "mode": "overwrite"
  }
}
