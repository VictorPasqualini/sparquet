{
  "name": "conf_registro_cerc_duplicata",
  "description": "Registro de Duplicata na CERC — UM arquivo para os 3 fluxos (REGISTRO, EMISSAO, EMISSAO_E_REGISTRO). Lê view_cessoes_pendentes, filtra DUPLICATA/CERC/fluxo, monta o payload do fluxo e grava no staging generico view_registro_staging (id_operacao, id_vert, id_cessao, numero_contrato, payload). Branching por skip_if_false com expressao sobre {fluxo_operacao} (orquestrador passa so fluxo_operacao). Janela unificada (id_cessao, lote_index): no REGISTRO o lote_index e o dense_rank por contrato (1 contrato por grupo); na emissao e floor((rank-1)/300) (lotes de 300). id_vert -> por contrato no REGISTRO, por lote na emissao; Kafka deduplica por id_vert no commit. Adaptacao de old/registro_cerc_duplicata.",

  "input": {
    "format": "view",
    "path": "view_cessoes_pendentes"
  },

  "transformations": [
    {
      "type": "filter",
      "condition": "tipo_ativo = '{tipo_ativo}' AND registradora = '{registradora}' AND fluxo_operacao = '{fluxo_operacao}' AND ((tipo_contrato = '{tipo_contrato}' AND multi_ativos = true) OR (multi_ativos = false))"
    },

    { "type": "stop_if_empty", "message": "Sem cessoes para DUPLICATA/CERC - registro nao iniciado" },

    { "type": "checkpoint" },

    { "type": "collect", "column": "id_cessao", "as": "cessoes_a_processar" },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.bronze_remessa" },
      "with_transformations": [
        { "type": "filter", "condition": "id_cessao IN ({{cessoes_a_processar}})" },
        {
          "type": "select",
          "columns": [
            "id_cessao", "numero_contrato", "nome_sacado", "documento_sacado", "tipo_pessoa_sacado",
            "municipio_sacado", "nome_cedente", "documento_cedente", "total_parcelas_contrato",
            "data_emissao_contrato", "data_vencimento_parcela", "nome_originador", "cnpj_originador",
            "informacoes_adicionais", "valor_face_parcela", "tipo_pessoa_cedente", "coobrigacao",
            "uf_sacado", "logradouro_sacado", "valor_aquisicao_parcela", "numero_nf_duplicata", "cep_sacado"
          ]
        }
      ],
      "on": ["id_cessao", "numero_contrato"],
      "how": "left"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_lastros_relacionamento" },
      "with_transformations": [
        { "type": "select", "columns": ["documento_entidade_relacionada", "municipio", "uf"] }
      ],
      "on": "l.documento_sacado = r.documento_entidade_relacionada",
      "how": "left"
    },

    { "type": "with_column", "column": "data_emissao_duplicata", "expression": "current_date()" },
    { "type": "with_column", "column": "informacoes_adicionais", "expression": "regexp_replace(informacoes_adicionais, '''', '\"')" },
    { "type": "with_column", "column": "informacoes_adicionais", "expression": "from_json(informacoes_adicionais, 'STRUCT<codigo_m_oper_cred: INT, codigo_s_m_oper_cred: INT, chave_unica_da_duplicata: STRING, especie_da_duplicata: STRING, data_emissao_da_duplicata: STRING, natureza_da_operacao: STRING>')" },

    {
      "type": "with_column",
      "skip_if_false": "'{fluxo_operacao}' in ('EMISSAO', 'EMISSAO_E_REGISTRO')",
      "columns": {
        "assinantes": "explode_outer(assinantes)"
      }
    },
    {
      "type": "with_column",
      "skip_if_false": "'{fluxo_operacao}' in ('EMISSAO', 'EMISSAO_E_REGISTRO')",
      "columns": {
        "cedentes": "explode_outer(cedentes)",
        "cedente_dado": "filter(array(cedentes), x -> x.documento_cedente = documento_cedente)[0]"
      }
    },

    {
      "type": "with_column",
      "skip_if_false": "'{fluxo_operacao}' = 'REGISTRO'",
      "column": "lote_index",
      "expression": "dense_rank() over (partition by id_cessao order by numero_contrato)"
    },
    {
      "type": "with_column",
      "skip_if_false": "'{fluxo_operacao}' in ('EMISSAO', 'EMISSAO_E_REGISTRO')",
      "column": "lote_index",
      "expression": "cast((dense_rank() over (partition by id_cessao order by numero_contrato) - 1) / 300 as int)"
    },

    { "type": "with_column", "column": "id_vert", "expression": "first(uuid()) over (partition by id_cessao, lote_index)" },

    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' in ('EMISSAO', 'EMISSAO_E_REGISTRO')",
      "column": "signer_item",
      "fields": {
        "email": "assinantes.email",
        "name": "assinantes.nome",
        "foreignPerson": "assinantes.pessoa_estrangeira",
        "document": "assinantes.documento",
        "authType": "assinantes.tipo_autenticacao"
      }
    },
    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' in ('EMISSAO', 'EMISSAO_E_REGISTRO')",
      "column": "document_item",
      "fields": {
        "fileExternalReference": "concat('Connectoway_', numero_contrato)",
        "product": "produto",
        "template.type": "cast(tipo_template as int)",
        "template.externalReference": "referencia_template",
        "template.inputs.sacado_nome.value": "nome_sacado",
        "template.inputs.duplicata_numero.value": "numero_contrato",
        "template.inputs.sacado_endereco.value": "logradouro_sacado",
        "template.inputs.sacado_municipio.value": "municipio",
        "template.inputs.sacado_uf.value": "uf",
        "template.inputs.duplicata_valor.value": "valor_face_parcela",
        "template.inputs.sacado_cnpj_cpf.value": "documento_sacado",
        "template.inputs.sacado_praca_pagamento.value": "'municipio'",
        "template.inputs.duplicata_data_emissao.value": "data_emissao_duplicata",
        "template.inputs.sacado_cep.value": "cep_sacado",
        "template.inputs.duplicata_vencimento.value": "data_vencimento_parcela",
        "template.inputs.fatura_valor_por_extenso.value": "valor_face_parcela",
        "template.inputs.endossatario_cpf_cnpj.value": "cnpj_fundo",
        "template.inputs.fatura_valor.value": "valor_face_parcela",
        "template.inputs.fatura_numero.value": "numero_nf_duplicata",
        "template.inputs.endossatario_nome.value": "nome_fundo",
        "template.inputs.cedente_cnpj_cpf.value": "lpad(cast(documento_cedente as string), 14, '0')",
        "template.inputs.cedente_nome.value": "nome_cedente",
        "template.inputs.cedente_municipio.value": "cedente_dado.cedente_municipio",
        "template.inputs.cedente_rua.value": "cedente_dado.cedente_rua",
        "template.inputs.cedente_agencia.value": "cedente_dado.cedente_agencia",
        "template.inputs.cedente_conta.value": "cedente_dado.cedente_conta",
        "template.inputs.cedente_bairro.value": "cedente_dado.cedente_bairro",
        "template.inputs.cedente_inscricao_estadual.value": "cedente_dado.cedente_inscricao_estadual",
        "template.inputs.cedente_banco.value": "cedente_dado.cedente_banco",
        "template.inputs.cedente_telefone.value": "cedente_dado.cedente_telefone",
        "template.inputs.cedente_uf.value": "cedente_dado.cedente_uf",
        "template.inputs.cedente_cep.value": "cedente_dado.cedente_cep",
        "template.inputs.cedente_inscricao_municipal.value": "cedente_dado.cedente_inscricao_municipal"
      }
    },
    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' in ('EMISSAO', 'EMISSAO_E_REGISTRO')",
      "column": "emissao_body",
      "fields": {
        "participant_document": "documento_participante",
        "envelope_external_reference": "id_cessao",
        "signer_list": "array_distinct(collect_list(signer_item) over (partition by id_cessao, lote_index))",
        "documents": "array_distinct(collect_list(document_item) over (partition by id_cessao, lote_index))"
      }
    },

    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' in ('REGISTRO', 'EMISSAO_E_REGISTRO')",
      "column": "registro_item",
      "fields": {
        "recebivel.identificador.numero": "numero_contrato",
        "recebivel.vencimento": "data_vencimento_parcela",
        "recebivel.valor": "cast(valor_face_parcela as float)",
        "recebivel.tipo": "informacoes_adicionais.especie_da_duplicata",
        "recebivel.documento_fiscal.identificador.numero": "informacoes_adicionais.chave_unica_da_duplicata",
        "recebivel.documento_fiscal.tipo": "informacoes_adicionais.natureza_da_operacao",
        "recebivel.partes.originador.documento.identificador.numero": "case when tipo_pessoa_cedente = '0' then lpad(cast(documento_cedente as string), 14, '0') else lpad(cast(documento_cedente as string), 11, '0') end",
        "recebivel.partes.originador.documento.tipo": "case when tipo_pessoa_cedente = '0' then 'cnpj' else 'cpf' end",
        "recebivel.partes.pagador.documento.identificador.numero": "case when tipo_pessoa_sacado = '0' then lpad(cast(documento_sacado as string), 14, '0') else lpad(cast(documento_sacado as string), 11, '0') end",
        "recebivel.partes.pagador.documento.tipo": "case when tipo_pessoa_sacado = '0' then 'cnpj' else 'cpf' end",
        "operacao_de_uso.envolvidos.cedente.documento.tipo": "case when tipo_pessoa_cedente = '0' then 'cnpj' else 'cpf' end",
        "operacao_de_uso.envolvidos.cedente.documento.identificador.numero": "case when tipo_pessoa_cedente = '0' then lpad(cast(documento_cedente as string), 14, '0') else lpad(cast(documento_cedente as string), 11, '0') end",
        "operacao_de_uso.codigo": "informacoes_adicionais.chave_unica_da_duplicata",
        "operacao_de_uso.tipo": "cast(case when coobrigacao = '0' then '2' else coobrigacao end as integer)",
        "operacao_de_uso.data": "case when informacoes_adicionais.data_emissao_da_duplicata is not null then informacoes_adicionais.data_emissao_da_duplicata else cast(data_emissao_duplicata as string) end",
        "operacao_de_uso.valor": "cast(valor_face_parcela as float)",
        "operacao_de_uso.vencimento": "data_vencimento_parcela",
        "operacao_de_uso.modalidade": "concat(cast(informacoes_adicionais.codigo_m_oper_cred as string), cast(informacoes_adicionais.codigo_s_m_oper_cred as string))",
        "operacao_de_uso.estado": "uf_sacado",
        "operacao_de_uso.cidade": "municipio_sacado",
        "operacao_de_uso.clausula_penal": "''",
        "operacao_de_uso.taxa_de_juros": "0",
        "operacao_de_uso.correcao_monetaria": "'0'",
        "operacao_de_uso.divida_total": "0",
        "operacao_de_uso.demais_encargos": "'0'",
        "referencia_externa": "id_vert",
        "informacoes_complementares.descricao": "''",
        "publicidade": "registro_publicidade"
      }
    },
    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' in ('REGISTRO', 'EMISSAO_E_REGISTRO')",
      "column": "registro_body",
      "fields": {
        "veiculo": { "id": "id_veiculo" },
        "registros": "array_distinct(collect_list(registro_item) over (partition by id_cessao, lote_index))"
      }
    },

    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' = 'REGISTRO'",
      "column": "payload",
      "fields": {
        "id_externo": "id_vert",
        "veiculo": "registro_body.veiculo",
        "registros": "registro_body.registros"
      }
    },
    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' = 'EMISSAO'",
      "column": "payload",
      "fields": {
        "id_externo": "id_vert",
        "participant_document": "emissao_body.participant_document",
        "envelope_external_reference": "emissao_body.envelope_external_reference",
        "signer_list": "emissao_body.signer_list",
        "documents": "emissao_body.documents"
      }
    },
    {
      "type": "struct",
      "skip_if_false": "'{fluxo_operacao}' = 'EMISSAO_E_REGISTRO'",
      "column": "payload",
      "fields": {
        "id_externo": "id_vert",
        "emissao": "emissao_body",
        "registro": "registro_body"
      }
    },

    {
      "type": "select",
      "columns": ["id_operacao", "id_vert", "id_cessao", "numero_contrato", "payload"]
    },

    { "type": "drop_duplicates", "columns": ["id_cessao", "numero_contrato"] }
  ],

  "output": {
    "format": "view",
    "path": "view_registro_staging",
    "mode": "overwrite"
  }
}
