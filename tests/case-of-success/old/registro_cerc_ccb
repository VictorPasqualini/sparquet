from typing import Any, Dict, Tuple
from pyspark.sql import functions as f
from pyspark.sql.column import Column
from pyspark.sql.types import DecimalType
from pyspark.sql.window import Window

def retorna_informacoes_adicionais(nome_coluna: str) -> Column:

    return f.coalesce(
        f.get_json_object(f.to_json(f.col("informacoes_adicionais")), f"$.{nome_coluna}"),
        f.lit(2),
    )

def retorna_coluna_baseada_na_parametrizacao(
    coluna: str,
    coluna_base: str,
    dados_auxiliares: bool = False,
    informacoes_adicionais: bool = False,
) -> Column:

    if informacoes_adicionais:
        coluna_origem = retorna_informacoes_adicionais(coluna_base)
    else:
        coluna_origem = f.col(f"base.{coluna_base}")

    if dados_auxiliares:
        return f.when(
            f.col("parametros.usa_dados_auxiliares") == True,
            f.col(f"{coluna}"),
        ).otherwise(retorna_informacoes_adicionais(coluna_origem))

    return (
        f.when(
            f.col("parametros.usa_dados_auxiliares") == True,
            f.col(f"dados_auxiliares.{coluna}"),
        )
        .when(
            f.col("parametros.usa_dados_do_sistema_emissor") == True,
            f.col(f"emissor_ccb.{coluna}"),
        )
        .otherwise(coluna_origem)
    )

def preparar_objeto_cessao_ccb(df_registro: Any) -> CessaoBasesAtivos:
    
    try:
        df_parcelas = spark.table("lastros.silver_parcela") 
        df_sacado = ( 
            spark.table("lastros.silver_sacado")
        )

        df_dados_auxiliares = (
            spark.table("lastros.silver_dados_auxiliares")
            .select(
                "id_operacao",
                "numero_contrato",
                "ipoc",
                "codigo_m_oper_cred",
                "codigo_s_m_oper_cred",
                "valor_total_credito",
                "valor_liquido_credito"
            )
            .toDF(
                "id_operacao",
                "numero_contrato",
                "identificacao_padronizada_operacao_credito",
                "codigo_modalidade_operacao_credito",
                "codigo_sub",
                "valor_total_credito",
                "valor_liquido_credito"
            )
            .alias("dados_auxiliares")
        )

        df_emissor_ccb = (
            spark.table("lastros.silver_emissao_ccb")
            .select(
                "id_operacao",
                "numero_ccb",
                "valor_total_credito",
                "valor_financiado",
                "data_emissao"
            )
            .toDF(
                "id_operacao",
                "numero_contrato",
                "valor_total_credito",
                "valor_liquido_credito",
                "data_transacao"
            )
            .alias("emissor_ccb")
        )

        return CessaoBasesAtivos(
            df_cessoes_pendentes_de_registro=df_registro,
            df_parcelas=df_parcelas,
            df_emissor_ccb=df_emissor_ccb,
            df_dados_auxiliares=df_dados_auxiliares,
            df_sacado=df_sacado,
        )
    
    except Exception as e:
        raise RuntimeError(
            "Falha ao preparar objeto 'CessaoBasesAtivos' em 'preparar_objeto_cessao_ccb()'"
        )

def cessao_registro_lastro_ccb(obj: CessaoBasesAtivos) -> Tuple[Any, Any]:
    
    try:
        df_cessoes_pendentes_de_registro = obj.df_cessoes_pendentes_de_registro
        df_sacado = obj.df_sacado
        df_dados_auxiliares = obj.df_dados_auxiliares
        df_emissor_ccb = obj.df_emissor_ccb
        df_parcelas = obj.df_parcelas

        df_contratos = (
            spark.table("lastros.silver_contrato")
            .join(
                spark.table("lastros.bronze_remessa")
                .alias("base")
                .select(
                    "numero_contrato",
                    "identificador_unico_registradora",
                    "cnpj_originador",
                    "nome_originador",
                    "nome_cedente",
                ),
                on=["numero_contrato"],
                how="inner",
            )
            .join(
                df_cessoes_pendentes_de_registro
                .select(
                    "id_cessao",
                    "usa_dados_do_sistema_emissor",
                    "usa_dados_auxiliares",
                    "indexacao",
                    "numero_contrato",
                )
                .alias("parametros"),
                on=["id_cessao", "numero_contrato"],
                how="inner",
            )
            .join(
                df_sacado.select(
                    "id_operacao", "documento_sacado", "tipo_pessoa_sacado", "nome_sacado"
                ),
                on=["id_operacao", "documento_sacado"],
                how="inner",
            )
            .join(df_dados_auxiliares, on=["id_operacao", "numero_contrato"], how="left")
            .join(df_emissor_ccb, on=["id_operacao", "numero_contrato"], how="left")
            .withColumn(
                "api_identificacao_padronizada_operacao_credito",
                retorna_coluna_baseada_na_parametrizacao(
                    "identificacao_padronizada_operacao_credito",
                    "identificador_unico_registradora",
                    dados_auxiliares=True,
                ),
            )
            .withColumn(
                "api_codigo_modalidade_operacao_credito",
                retorna_coluna_baseada_na_parametrizacao(
                    "codigo_modalidade_operacao_credito",
                    "codigo_m_oper_cred",
                    dados_auxiliares=True,
                    informacoes_adicionais=True,
                ),
            )
            .withColumn(
                "api_codigo_sub",
                retorna_coluna_baseada_na_parametrizacao(
                    "codigo_sub",
                    "codigo_s_m_oper_cred",
                    dados_auxiliares=True,
                    informacoes_adicionais=True,
                ),
            )
            .withColumn("api_indexacao", f.col("parametros.indexacao"))
            .withColumn(
                "api_valor_total_credito_base",
                retorna_coluna_baseada_na_parametrizacao(
                    "valor_total_credito",
                    "valor_total_credito",
                    informacoes_adicionais=True,
                ),
            )
            .withColumn(
                "api_valor_liquido_credito",
                retorna_coluna_baseada_na_parametrizacao(
                    "valor_liquido_credito",
                    "valor_liquido_credito",
                    informacoes_adicionais=True,
                ),
            )
            .withColumn(
                "api_valor_total_credito",
                f.when(
                    f.col("id_operacao").isin([500, 587]),
                    f.col("valor_nominal_contrato"),
                ).otherwise(f.col("api_valor_total_credito_base")),
            )
            .drop(
                "dados_auxiliares.valor_total_credito",
                "dados_auxiliares.valor_liquido_credito",
                "dados_auxiliares.codigo_sub",
                "emissor_ccb.valor_total_credito",
                "emissor_ccb.valor_liquido_credito",
                "api_valor_total_credito_base",
            )
        )

        df_parcelas = df_parcelas.join(
            df_cessoes_pendentes_de_registro.select("id_cessao", "numero_contrato"),
            on=["id_cessao", "numero_contrato"],
            how="inner",
        )

        df_parcelas_struct = (
            df_parcelas.orderBy("numero_contrato", "numero_parcela")
            .groupBy("id_cessao", "numero_contrato")
            .agg(
                f.collect_list(
                    f.struct(
                        f.col("identificador_parcela").alias("codigo_controle_parcela_contrato_if"),
                        f.col("data_vencimento_parcela").alias("data_vencimento_parcela"),
                        f.col("valor_face_parcela").cast("decimal(15,2)").alias("valor_parcela"),
                        f.col("valor_aquisicao_parcela")
                        .cast("decimal(15, 2)")
                        .alias("valor_principal_parcela"),
                        f.col("numero_parcela").alias("numero_parcela"),
                    )
                ).alias("parcelas")
            )
        )

        # Cria um DataFrame com contagem e soma de parcelas por contrato (sem duplicação)
        df_parcelas_agg = (
            df_parcelas
            .select(
                "id_cessao",
                "numero_contrato",
                "numero_parcela",
                "valor_face_parcela",
                "valor_principal_parcela",
            )
            .distinct()
            .groupBy("id_cessao", "numero_contrato")
            .agg(
                f.count("numero_parcela").alias("count_parcelas"),
                f.sum("valor_face_parcela").alias("sum_valor_face"),
                f.sum("valor_principal_parcela").alias("sum_valor_principal"),
            )
        )
        
    except Exception as e:
        raise RuntimeError(
            "Falha na preparação dos dataframes em 'cessao_registro_lastro_ccb()'"
        )

    try:
        df_registro_struct = (
            df_contratos
            .join(
                df_parcelas_agg,
                on=["id_cessao", "numero_contrato"],
                how="left",
            )
            .withColumn(
                "total_parcelas_contrato_checked",
                f.when(
                    # se já tiver valor válido, mantém
                    (f.col("total_parcelas_contrato").isNotNull()) &
                    (f.col("total_parcelas_contrato") != ""),
                    f.col("total_parcelas_contrato")
                ).otherwise(
                    # caso contrário, define com base na contagem de parcelas
                    f.col("count_parcelas")
                )
            )
            .withColumn(
                "api_valor_total_credito_checked",
                f.when(
                    (f.col("api_valor_total_credito").isNotNull()) &
                    (f.col("api_valor_total_credito") != ""),
                    f.col("api_valor_total_credito")
                ).otherwise(
                    # Caso contrário, define como a soma dos valores das parcelas
                    f.col("sum_valor_face")
                )
            )
            .withColumn(
                "api_valor_liquido_credito_checked",
                f.when(
                    (f.col("api_valor_liquido_credito").isNotNull()) &
                    (f.col("api_valor_liquido_credito") != ""),
                    f.col("api_valor_liquido_credito")
                ).otherwise(
                    # Caso contrário, define como a soma dos valores das parcelas
                    f.col("sum_valor_principal")
                )
            )
            .drop("count_parcelas", "sum_valor_face", "sum_valor_principal")
            .withColumn(
                "tipo_pessoa_sacado_checked",
                f.when(
                    # se já tiver valor válido, mantém
                    (f.col("tipo_pessoa_sacado").isNotNull()) &
                    (f.col("tipo_pessoa_sacado") != "") &
                    (f.col("tipo_pessoa_sacado").cast("string") != "0"),
                    f.col("tipo_pessoa_sacado")
                ).otherwise(
                    # caso contrário, define com base no tamanho do documento
                    f.when(
                        f.length(f.regexp_replace(f.col("documento_sacado"), r"\D", "")) <= 11,
                        f.lit(1)
                    ).otherwise(
                        f.lit(2)
                    )
                )
            )
            .withColumn(
                "documento_sacado_checked",
                f.when(
                    f.col("tipo_pessoa_sacado_checked") == 1,
                    f.lpad(f.col("documento_sacado"), 11, "0"),
                ).otherwise(f.lpad(f.col("documento_sacado"), 14, "0")),
            )
            .join(
                df_cessoes_pendentes_de_registro,
                on=["id_operacao", "id_cessao", "numero_contrato"],
                how="inner",
            )
            .withColumn(
                "originador_cnpj_checked",
                f.coalesce(
                    f.col("originador_cnpj"),
                    f.lpad(f.col("base.cnpj_originador"), 14, "0"),
                ),
            )
            .withColumn(
                "numero_documento_emissor_checked",
                f.coalesce(
                    f.col("numero_documento_emissor"),
                    f.lpad(f.col("documento_cedente"), 14, "0"),
                ),
            )
            .withColumn(
                "nome_razao_social_emissor_checked",
                f.coalesce(
                    f.col("nome_razao_social_emissor"),
                    f.col("nome_cedente"),
                ),
            )
            .withColumn(
                "credor_numero_documento_checked",
                f.coalesce(
                    f.col("credor_numero_documento"),
                    f.lpad(f.col("documento_cedente"), 14, "0"),
                ),
            )
            .withColumn(
                "nome_razao_social_credor_checked",
                f.coalesce(
                    f.col("nome_razao_social_credor"),
                    f.col("nome_cedente"),
                ),
            ).withColumn(
                "api_codigo_modalidade_operacao_credito_checked",
                f.when(
                    # Se já tiver valor válido, mantém
                    (f.col("api_codigo_modalidade_operacao_credito").isNotNull()) &
                    (f.col("api_codigo_modalidade_operacao_credito") != "") &
                    (f.col("api_codigo_modalidade_operacao_credito").cast("string") != "0"),
                    f.col("api_codigo_modalidade_operacao_credito")
                )
                .otherwise(
                    # caso contrário, preenche com o valor parametrizado
                    f.col("codigo_modalidade_credito")
                )
            ).withColumn(
                "api_codigo_sub_checked",
                f.when(
                    # Se já tiver valor válido, mantém
                    (f.col("api_codigo_sub").isNotNull()) &
                    (f.col("api_codigo_sub") != "") &
                    (f.col("api_codigo_sub").cast("string") != "0"),
                    f.col("api_codigo_sub")
                )
                .otherwise(
                    # caso contrário, preenche com o valor parametrizado
                    f.col("subcodigo_modalidade_credito")
                )
            ).withColumn(
                "api_identificacao_padronizada_operacao_credito_checked",
                f.when(
                    (f.col("api_identificacao_padronizada_operacao_credito").isNull()) |
                    (f.col("api_identificacao_padronizada_operacao_credito") == "") |
                    (f.col("api_identificacao_padronizada_operacao_credito").cast("string") == "0"),

                    # monta o IPOC se estiver vazio/nulo/0
                    f.concat(
                        # 8 primeiros digitos do CNPJ da instituição
                        f.substring(f.col("numero_documento_emissor_checked"), 1, 8),

                        # 4 digitos do codigo da modalidade
                        f.substring(f.col("api_codigo_modalidade_operacao_credito_checked"), 1, 2),
                        f.substring(f.col("api_codigo_sub_checked"), 1, 2),

                        # 1 digito tipo do cliente
                        f.col("tipo_pessoa_sacado_checked").cast("string"),

                        # documento do sacado
                        f.when(f.col("tipo_pessoa_sacado_checked") == 1, f.substring(f.col("documento_sacado_checked"), 1, 11))
                        .when(f.col("tipo_pessoa_sacado_checked") == 2, f.substring(f.col("documento_sacado_checked"), 1, 8))
                        .otherwise(f.lpad(f.col("documento_sacado_checked"), 14, "0")),

                        # número do contrato até 40 caracteres
                        f.substring(f.col("numero_contrato"), 1, 40)
                    )
                ).otherwise(
                    f.col("api_identificacao_padronizada_operacao_credito")
                )
            ).drop(
                "api_codigo_modalidade_operacao_credito",
                "api_codigo_sub",
                "api_identificacao_padronizada_operacao_credito",
                "tipo_pessoa_sacado",
                "documento_sacado",
                "originador_cnpj",
                "numero_documento_emissor",
                "nome_razao_social_emissor",
                "credor_numero_documento",
                "nome_razao_social_credor",
            )
        )

        df_registro_struct = (
            df_registro_struct.drop("informacoes_adicionais")
            .dropDuplicates()
            .select(
                "id_operacao",
                "id_cessao",
                "numero_contrato",
                f.struct(
                    f.col("tipo_ativo").alias("tipo_ativo"),
                    f.col("api_identificacao_padronizada_operacao_credito_checked").alias(
                        "identificacao_padronizada_operacao_credito"
                    ),
                    f.col("api_codigo_modalidade_operacao_credito_checked").alias(
                        "codigo_modalidade_operacao_credito"
                    ),
                    f.col("api_codigo_sub_checked").alias("codigo_sub"),
                    f.col("numero_contrato").alias("codigo_contrato_operacao_credito"),
                    f.col("data_emissao_contrato").alias("data_transacao"),
                    f.col("api_valor_total_credito_checked").cast(DecimalType(15, 2)).alias("valor_total_credito"),
                    f.col("api_valor_liquido_credito_checked").cast(DecimalType(15, 2)).alias("valor_liquido_credito"),
                    f.col("taxa_contrato").cast(DecimalType(10, 4)).alias("taxa_juros_operacao"),
                    f.col("parametros.indexacao").cast("string").alias("indexacao"),
                    f.col("total_parcelas_contrato_checked").alias("quantidade_parcela_contratada"),
                    f.col("numero_contrato").alias("referencia_externa"),
                ).alias("contrato_valores"),
                f.struct(
                    f.col("originador_cnpj_checked").alias("originador_cnpj"),
                    f.col("detentor_cnpj").alias("detentor_cnpj"),
                    f.col("detentor_carteira").alias("detentor_carteira"),
                    f.col("cnpj_agente_registro").alias("cnpj_agente_registro"),
                    f.array_distinct(
                        f.collect_list(
                            f.struct(
                                f.col("tipo_pessoa_sacado_checked").cast("integer").alias("devedor_tipo_pessoa"),
                                f.col("documento_sacado_checked").cast("string").alias("devedor_numero_documento"),
                                f.col("nome_sacado").alias("devedor_nome_razao_social"),
                            )
                        ).over(Window.partitionBy("numero_contrato"))
                    ).alias("devedores"),
                    f.col("tipo_pessoa_sacado_checked").cast("integer").alias("beneficiario_tipo_pessoa"),
                    f.col("documento_sacado_checked").cast("string").alias("beneficiario_numero_documento"),
                    f.col("tipo_pessoa_emissor").alias("tipo_pessoa_emissor"),
                    f.col("numero_documento_emissor_checked").alias("numero_documento_emissor"),
                    f.col("nome_razao_social_emissor_checked").alias("nome_razao_social_emissor"),
                    f.array_distinct(
                        f.collect_list(
                            f.struct(
                                f.col("credito_tipo_pessoa").alias("credor_tipo_pessoa"),
                                f.col("credor_numero_documento_checked").alias("credor_numero_documento"),
                                f.col("nome_razao_social_credor_checked").alias("nome_razao_social_credor"),
                            )
                        ).over(Window.partitionBy("numero_contrato"))
                    ).alias("credores"),
                ).alias("agentes"),
            )
            .distinct()
            .withColumn("id_vert", f.expr("uuid()"))
            .join(df_parcelas_struct, on=["id_cessao", "numero_contrato"], how="inner")
            .withColumn("status", f.lit(""))
            .withColumn(
                "payload",
                f.struct(
                    f.col("id_vert").alias("id_vert"),
                    f.col("contrato_valores").alias("contrato_valores"),
                    f.col("agentes").alias("agentes"),
                    f.col("parcelas").alias("parcelas"),
                    f.col("status").alias("status"),
                ),
            )
            .drop("contrato_valores", "agentes")
        )

        df_registro_struct.count()
        df_registro_struct = df_registro_struct.localCheckpoint()

        headers = f.array(
            f.struct(f.lit("type").alias("key"), f.lit("REGISTRO").cast("binary").alias("value")),
            f.struct(f.lit("kind").alias("key"), f.lit("ENVIO").cast("binary").alias("value")),
        )

    except Exception as e:
        raise RuntimeError(
            "Falha na montagem do payload em 'cessao_registro_lastro_ccb()'"
        )
     
    try:  
        df_envio_registro = (
            df_registro_struct.withColumn("value", f.to_json("payload")).select("value", headers.alias("headers"))
        )
        
        return df_envio_registro, df_registro_struct
    
    except Exception as e:
        raise RuntimeError(
            "Falha no parsing do payload para JSON em 'cessao_registro_lastro_ccb()'"
        ) from e