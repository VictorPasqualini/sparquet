{
  "name": "conf_cessoes_pendentes_registro",
  "description": "Monta a base de cessões pendentes para registro, se baseando nas cessões aprovadas na etapa de critérios e que estejam parametrizadas para registro, cada operação com seu fluxo, tipo ativo e registradora.",

  "input": {
    "format": "delta",
    "path": "lastros.silver_cessao"
  },

  "transformations": [
    {
      "type": "select",
      "columns": [
        "id_cessao", 
        "id_operacao"
      ]
    },

    {
      "type": "join",
      "with": { 
        "format": "delta", 
        "path": "lastros.silver_cessoes_status" 
      },
      "with_transformations": [
        { 
          "type": "filter", 
          "condition": "status IN (1, 10, 11)"
        },
        {
          "type": "select",
          "columns": [
            "id_cessao"
          ]
        },
        {
          "type": "distinct"
        }
      ],
      "on": "id_cessao",
      "how": "leftsemi"
    },

    {
      "type": "join",
      "with": {
        "format": "delta", 
        "path": "lastros.silver_parametrizacao_registro_lastro"
      },
      "on": "id_operacao",
      "how": "inner"
    },

    {
      "type": "filter",
      "skip_if_false": "{lista_contratos}",
      "condition": "numero_contrato IN ({lista_contratos})"
    },
    
    {
      "type": "filter",
      "skip_if_false": "{lista_cessoes}",
      "condition": "id_cessao IN ({lista_cessoes})"
    },

    {
      "type": "filter",
      "skip_if_false": "{lista_operacoes}",
      "condition": "id_operacao IN ({lista_operacoes})"
    },

    {
      "type": "join",
      "skip_if_false": "{processar_somente_cessoes_pendentes}",
      "with": {
        "format": "delta",
        "path": "lastros.silver_controle_registro_cessoes"
      },
      "with_transformations": [
        {
          "type": "select",
          "columns": [
            "id_cessao"
          ]
        },
        {
          "type": "distinct"
        }
      ],
      "on": "id_operacao",
      "how": "leftanti"
    },

    {
      "type": "checkpoint"
    },

    {
      "type": "join",
      "with": {
        "format": "delta",
        "path": "lastros.silver_contrato"
      },
      "with_transformations": [
        {
          "type": "select",
          "columns": [
            "id_cessao", 
            "id_operacao", 
            "numero_contrato", 
            "data_referencia"
          ]
        },
        {
          "type": "filter",
          "condition": "id_cessao IN ({cessoes_pendentes})"
        },
        {
          "type": "join",
          "with": {
            "format": "delta",
            "path": "lastros.silver_status_criterios_contratos"
          },
          "with_transformations": [
            {
              "type": "select",
              "columns": [
                "id_cessao", 
                "id_operacao", 
                "numero_contrato", 
                "status_criterio"
              ]
            }
          ],
          "on": "l.id_cessao = r.id_cessao and l.id_operacao = r.id_operacao and l.numero_contrato = r.numero_contrato",
          "how": "left"
        },
        {
          "type": "select",
          "columns": [
            "case when status_criterio is null then true else status_criterio end as status_criterio_contrato",
            "id_cessao",
            "numero_contrato",
            "data_referencia"
          ]
        },
        {
          "type": "filter",
          "condition": "status_criterio_contrato = true"
        },
        {
          "type": "distinct"
        }
      ],
      "on": "id_cessao",
      "how": "leftsemi"
    },

    {
      "type": "join",
      "with": {
        "format": "delta",
        "path": "lastros.bronze_remessa"
      },
      "with_transformations": [
        {
          "type": "select",
          "columns": [
            "id_cessao",
            "numero_contrato",
            "tipo_contrato"
          ]
        },
        { 
          "type": "group_by",
          "by": ["id_cessao", "numero_contrato"],
          "agg": [
            "first(tipo_contrato) as tipo_contrato"
          ]
        }
      ],
      "on": "l.id_cessao = r.id_cessao and l.numero_contrato = r.numero_contrato",
      "how": "left"
    },

    

    {
      "type": "checkpoint"
    },

    {
      "type": "debug",
      "label": "Cessões a processar",
      "actions": [
        "show"
      ]
    }
  ],

  "output": {
    "format": "view",
    "path":   "view_cessoes_pendentes",
    "mode":   "overwrite",
    "options": { "cache": "false" }
  }
}
