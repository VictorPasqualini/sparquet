{
  "name": "conf_cessoes_pendentes_registro",
  "description": "Monta a base de cessoes pendentes de registro: cessoes aprovadas em criterios, parametrizadas para registro, ainda nao enviadas (quando processar_somente_cessoes_pendentes), enriquecidas com numero_contrato, data_referencia, tipo_contrato e flag multi_ativos. Adaptacao declarativa do job_registro_old.py (ETAPAS 2 a 6).",

  "input": {
    "format": "delta",
    "path": "lastros.silver_cessao"
  },

  "transformations": [
    {
      "type": "select",
      "columns": ["id_cessao", "id_operacao"]
    },

    {
      "type": "join",
      "with": {
        "format": "delta",
        "path": "lastros.silver_cessoes_status"
      },
      "with_transformations": [
        { "type": "filter", "condition": "status IN (1, 10, 11)" },
        { "type": "select", "columns": ["id_cessao"] },
        { "type": "distinct" }
      ],
      "on": "id_cessao",
      "how": "leftsemi"
    },

    {
      "type": "join",
      "with": {
        "format": "delta",
        "path": "lastros.silver_parametrizacao_registro_lastro"
      },
      "on": "id_operacao",
      "how": "inner"
    },

    {
      "type": "filter",
      "skip_if_false": "{lista_cessoes}",
      "condition": "id_cessao IN ({lista_cessoes})"
    },

    {
      "type": "filter",
      "skip_if_false": "{lista_operacoes}",
      "condition": "id_operacao IN ({lista_operacoes})"
    },

    {
      "type": "join",
      "skip_if_false": "{processar_somente_cessoes_pendentes}",
      "with": {
        "format": "delta",
        "path": "lastros.silver_controle_registro_cessoes"
      },
      "with_transformations": [
        { "type": "select", "columns": ["id_cessao"] },
        { "type": "distinct" }
      ],
      "on": "id_cessao",
      "how": "leftanti"
    },

    { "type": "checkpoint" },

    {
      "type": "join",
      "with": {
        "format": "delta",
        "path": "lastros.silver_contrato"
      },
      "with_transformations": [
        {
          "type": "select",
          "columns": ["id_cessao", "id_operacao", "numero_contrato", "data_referencia"]
        },
        {
          "type": "join",
          "with": {
            "format": "delta",
            "path": "lastros.silver_status_criterios_contratos"
          },
          "with_transformations": [
            {
              "type": "select",
              "columns": ["id_cessao", "id_operacao", "numero_contrato", "status_criterio"]
            }
          ],
          "on": ["id_cessao", "id_operacao", "numero_contrato"],
          "how": "left"
        },
        {
          "type": "select",
          "columns": [
            "case when status_criterio is null then true else status_criterio end as status_criterio_contrato",
            "id_cessao",
            "numero_contrato",
            "data_referencia"
          ]
        },
        { "type": "filter", "condition": "status_criterio_contrato = true" },
        { "type": "distinct" }
      ],
      "on": "id_cessao",
      "how": "inner"
    },

    {
      "type": "filter",
      "skip_if_false": "{lista_contratos}",
      "condition": "numero_contrato IN ({lista_contratos})"
    },

    {
      "type": "join",
      "with": {
        "format": "delta",
        "path": "lastros.bronze_remessa"
      },
      "with_transformations": [
        {
          "type": "select",
          "columns": ["id_cessao", "numero_contrato", "tipo_contrato"]
        },
        {
          "type": "group_by",
          "by": ["id_cessao", "numero_contrato"],
          "agg": ["first(tipo_contrato) as tipo_contrato"]
        }
      ],
      "on": ["id_cessao", "numero_contrato"],
      "how": "left"
    },

    {
      "type": "join",
      "with": {
        "format": "delta",
        "path": "lastros.silver_parametrizacao_registro_lastro"
      },
      "with_transformations": [
        {
          "type": "select",
          "columns": ["id_operacao", "tipo_ativo", "registradora"]
        },
        { "type": "distinct" },
        {
          "type": "group_by",
          "by": ["id_operacao"],
          "agg": ["count(distinct struct(tipo_ativo, registradora)) > 1 as multi_ativos"]
        }
      ],
      "on": "id_operacao",
      "how": "left"
    },

    { "type": "checkpoint" },

    {
      "type": "debug",
      "label": "Cessoes a processar",
      "actions": ["count", "show"]
    }
  ],

  "output": {
    "format": "view",
    "path": "view_cessoes_pendentes",
    "mode": "overwrite",
    "options": { "cache": "false" }
  }
}
