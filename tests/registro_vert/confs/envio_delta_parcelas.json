{
  "name": "envio_delta_parcelas",
  "description": "Grava em lastros.silver_registro_parcelas uma linha por parcela do array 'parcelas' do payload. Faz explode + projeta os campos da struct para colunas planas.",

  "input": {
    "format": "view",
    "path":   "${param_view_payload}"
  },

  "transformations": [
    { "type": "with_column",
      "name": "parcela",
      "expression": "explode(parcelas)" },

    { "type": "with_column",
      "name": "identificador_parcela",
      "expression": "parcela.codigo_controle_parcela_contrato_if" },

    { "type": "with_column",
      "name": "numero_parcela",
      "expression": "parcela.numero_parcela" },

    { "type": "with_column",
      "name": "status_parcela",
      "expression": "'ENVIADO_PARA_REGISTRO'" },

    { "type": "with_column",
      "name": "data_baixa",
      "expression": "cast(NULL as date)" }
  ],

  "output": {
    "format":  "delta",
    "path":    "lastros.silver_registro_parcelas",
    "mode":    "append",
    "columns": ["id_operacao", "id_vert", "id_cessao", "numero_contrato",
                "identificador_parcela", "numero_parcela", "status_parcela",
                "data_baixa"],
    "options": { "mergeSchema": "true" }
  }
}
