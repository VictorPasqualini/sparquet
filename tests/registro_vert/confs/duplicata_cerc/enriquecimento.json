{
  "name": "duplicata_cerc_enriquecimento",
  "description": "Enriquecimento comum aos 3 subfluxos de Duplicata (REGISTRO/EMISSAO/EMISSAO_E_REGISTRO). Lê cessoes_pendentes (filtrada por DUPLICATA/CERC sem filtro de fluxo) e junta bronze_remessa + silver_lastros_relacionamento + silver_parcela agregada. Faz parsing de informacoes_adicionais. Cada payload da Duplicata lê desta view e aplica seu filter de fluxo + struct específico.",

  "params": [
    "param_lista_cessoes_pendentes"
  ],

  "input": {
    "format": "view",
    "path":   "cessoes_pendentes"
  },

  "transformations": [
    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.bronze_remessa" },
      "with_transformations": [
        { "type": "filter",
          "skip_if":   "${param_lista_cessoes_pendentes} IS NULL",
          "condition": "array_contains(${param_lista_cessoes_pendentes}, id_cessao)" },
        { "type": "select",
          "columns": ["id_cessao", "numero_contrato", "nome_sacado", "documento_sacado",
                      "tipo_pessoa_sacado", "municipio_sacado", "nome_cedente",
                      "documento_cedente", "total_parcelas_contrato", "data_emissao_contrato",
                      "data_vencimento_parcela", "nome_originador", "cnpj_originador",
                      "informacoes_adicionais", "valor_face_parcela", "tipo_pessoa_cedente",
                      "coobrigacao", "uf_sacado", "logradouro_sacado", "valor_aquisicao_parcela",
                      "numero_nf_duplicata", "cep_sacado"] },
        { "type": "drop_duplicates", "columns": ["id_cessao", "numero_contrato"] }
      ],
      "on":  ["id_cessao", "numero_contrato"],
      "how": "inner"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_lastros_relacionamento" },
      "with_transformations": [
        { "type": "select",
          "columns": ["documento_entidade_relacionada", "municipio", "uf"] }
      ],
      "on":  "l.documento_sacado = r.documento_entidade_relacionada",
      "how": "left"
    },

    { "type": "with_columns",
      "columns": [
        { "name": "informacoes_adicionais",
          "expression": "regexp_replace(informacoes_adicionais, \"'\", '\"')" },
        { "name": "data_emissao_duplicata",
          "expression": "current_date()" }
      ] },

    { "type": "with_column", "name": "informacoes_adicionais",
      "expression": "from_json(informacoes_adicionais, 'STRUCT<codigo_m_oper_cred: INT, codigo_s_m_oper_cred: INT, chave_unica_da_duplicata: STRING, especie_da_duplicata: STRING, data_emissao_da_duplicata: STRING, natureza_da_operacao: STRING>')" },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_parcela" },
      "with_transformations": [
        { "type": "filter",
          "skip_if":   "${param_lista_cessoes_pendentes} IS NULL",
          "condition": "array_contains(${param_lista_cessoes_pendentes}, id_cessao)" },
        { "type": "sort", "columns": ["numero_contrato", "numero_parcela"] },
        { "type": "group_by",
          "by": ["id_cessao", "numero_contrato"],
          "agg": [
            { "func": "expr",
              "expression": "collect_list(struct(identificador_parcela as codigo_controle_parcela_contrato_if, data_vencimento_parcela as data_vencimento_parcela, cast(valor_face_parcela as decimal(15,2)) as valor_parcela, cast(valor_aquisicao_parcela as decimal(15,2)) as valor_principal_parcela, numero_parcela as numero_parcela))",
              "alias": "parcelas" }
          ] }
      ],
      "on":  ["id_cessao", "numero_contrato"],
      "how": "left"
    },

    { "type": "checkpoint" }
  ],

  "output": {
    "format": "view",
    "path":   "duplicata_cerc_enriquecido",
    "mode":   "overwrite"
  }
}
