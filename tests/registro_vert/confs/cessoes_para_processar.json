{
  "name": "cessoes_para_processar",
  "description": "Enriquece cessões base com a flag multi_ativos (operação com >1 par tipo_ativo/registradora) via auto-join + group_by(expr). Faz anti-join opcional com silver_controle_registro_cessoes (skipável quando processar somente pendentes está desligado). Grava view cached para o loop por fluxo.",

  "input": {
    "format": "view",
    "path":   "cessoes_base"
  },

  "transformations": [
    {
      "type": "join",
      "with": "self",
      "with_transformations": [
        { "type": "select", "columns": ["id_operacao", "tipo_ativo", "registradora"] },
        { "type": "drop_duplicates" },
        { "type": "group_by",
          "by": ["id_operacao"],
          "agg": [
            { "func": "expr",
              "expression": "count(distinct struct(tipo_ativo, registradora)) > 1",
              "alias": "multi_ativos" }
          ] },
        { "type": "select", "columns": ["id_operacao", "multi_ativos"] }
      ],
      "on":  ["id_operacao"],
      "how": "left"
    },

    {
      "type": "join",
      "skip_if_null": "param_processar_somente_pendentes",
      "with": { "format": "delta", "path": "lastros.silver_controle_registro_cessoes" },
      "with_transformations": [
        { "type": "select", "columns": ["id_cessao"] },
        { "type": "drop_duplicates" }
      ],
      "on":  ["id_cessao"],
      "how": "leftanti"
    }
  ],

  "output": {
    "format": "view",
    "path":   "cessoes_para_processar",
    "mode":   "overwrite",
    "options": { "cache": "true" }
  }
}
