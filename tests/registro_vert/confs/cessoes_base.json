{
  "name": "cessoes_base",
  "description": "Monta a base completa de cessões pendentes de registro em um único passo declarativo. multi_ativos é calculado via window function (collect_set + size) — mais eficiente que self-join. Filtros opcionais (cessoes/operacoes/contratos) são aplicados via array_contains com skip_if quando o param está vazio. Anti-join opcional com a tabela de controle. Materializa via checkpoint para uso pelo loop por fluxo.",

  "params": [
    "param_lista_cessoes",
    "param_lista_operacoes",
    "param_lista_contratos",
    "param_processar_somente_pendentes"
  ],

  "input": {
    "format": "delta",
    "path":   "lastros.silver_cessao"
  },

  "transformations": [
    { "type": "select", "columns": ["id_cessao", "id_operacao"] },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_cessoes_status" },
      "with_transformations": [
        { "type": "filter", "condition": "status IN (1, 10, 11)" }
      ],
      "on":  "id_cessao",
      "how": "leftsemi"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_parametrizacao_registro_lastro" },
      "on":   "id_operacao",
      "how":  "inner"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_contrato" },
      "with_transformations": [
        {
          "type": "join",
          "with": { "format": "delta", "path": "lastros.silver_status_criterios_contratos" },
          "with_transformations": [
            { "type": "select",
              "columns": ["id_cessao", "id_operacao", "numero_contrato", "status_criterio"] }
          ],
          "on":   ["id_cessao", "id_operacao", "numero_contrato"],
          "how":  "left"
        },
        { "type": "with_column",
          "name": "status_criterio_contrato",
          "expression": "CASE WHEN status_criterio IS NULL THEN TRUE ELSE status_criterio END" },
        { "type": "group_by",
          "by": ["id_cessao", "id_operacao", "numero_contrato", "data_referencia"],
          "agg": [
            { "func": "min", "column": "status_criterio_contrato", "alias": "status_criterio_contrato" }
          ] },
        { "type": "filter", "condition": "status_criterio_contrato = TRUE" },
        { "type": "select", "columns": ["id_cessao", "numero_contrato", "data_referencia"] }
      ],
      "on":  "id_cessao",
      "how": "inner"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.bronze_remessa" },
      "with_transformations": [
        { "type": "select", "columns": ["id_cessao", "numero_contrato", "tipo_contrato"] },
        { "type": "group_by",
          "by": ["id_cessao", "numero_contrato"],
          "agg": [
            { "func": "first", "column": "tipo_contrato", "alias": "tipo_contrato" }
          ] }
      ],
      "on":  ["id_cessao", "numero_contrato"],
      "how": "left"
    },

    { "type": "with_column",
      "name": "multi_ativos",
      "expression": "size(collect_set(struct(tipo_ativo, registradora)) over (partition by id_operacao)) > 1" },

    { "type": "filter",
      "skip_if":   "${param_lista_cessoes} IS NULL",
      "condition": "array_contains(${param_lista_cessoes}, id_cessao)" },
    { "type": "filter",
      "skip_if":   "${param_lista_operacoes} IS NULL",
      "condition": "array_contains(${param_lista_operacoes}, id_operacao)" },
    { "type": "filter",
      "skip_if":   "${param_lista_contratos} IS NULL",
      "condition": "array_contains(${param_lista_contratos}, numero_contrato)" },

    {
      "type": "join",
      "skip_if": "${param_processar_somente_pendentes} IS NULL OR ${param_processar_somente_pendentes} = false",
      "with": { "format": "delta", "path": "lastros.silver_controle_registro_cessoes" },
      "with_transformations": [
        { "type": "select", "columns": ["id_cessao"] },
        { "type": "drop_duplicates" }
      ],
      "on":  ["id_cessao"],
      "how": "leftanti"
    },

    { "type": "checkpoint" }
  ],

  "output": {
    "format": "view",
    "path":   "cessoes_base",
    "mode":   "overwrite"
  }
}
