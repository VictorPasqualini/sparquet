{
  "name": "cpr_b3_cessoes_pendentes",
  "description": "Filtra cessoes_base para o fluxo CPR / B3 e enriquece com bronze_remessa (sacado, cedente, originador, taxa_contrato) e silver_dados_auxiliares (informacoes_adicionais via explode no payload). Otimiza a leitura via param_lista_cessoes_pendentes.",

  "params": [
    "param_tipo_ativo",
    "param_registradora",
    "param_fluxo_operacao",
    "param_lista_cessoes_pendentes"
  ],

  "input": {
    "format": "view",
    "path":   "cessoes_base"
  },

  "transformations": [
    { "type": "filter",
      "condition": "tipo_ativo = param_tipo_ativo AND registradora = param_registradora AND fluxo_operacao = param_fluxo_operacao AND ((tipo_contrato = '4' AND multi_ativos) OR NOT multi_ativos)" },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.bronze_remessa" },
      "with_transformations": [
        { "type": "filter",
          "skip_if_null": "param_lista_cessoes_pendentes",
          "condition": "array_contains(param_lista_cessoes_pendentes, id_cessao)" },
        { "type": "select",
          "columns": ["id_cessao", "numero_contrato", "nome_sacado", "documento_sacado",
                      "tipo_pessoa_sacado", "municipio_sacado", "nome_cedente",
                      "documento_cedente", "total_parcelas_contrato", "data_emissao_contrato",
                      "data_vencimento_parcela", "nome_originador", "cnpj_originador",
                      "taxa_contrato"] },
        { "type": "drop_duplicates", "columns": ["id_cessao", "numero_contrato"] }
      ],
      "on":  ["id_cessao", "numero_contrato"],
      "how": "inner"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_dados_auxiliares" },
      "with_transformations": [
        { "type": "select",
          "columns": ["numero_contrato", "data_referencia", "informacoes_adicionais"] }
      ],
      "on":  ["numero_contrato", "data_referencia"],
      "how": "inner"
    },

    { "type": "with_column", "name": "dados_auxiliares",
      "expression": "explode(informacoes_adicionais)" }
  ],

  "output": {
    "format":  "view",
    "path":    "cpr_b3_pendentes",
    "mode":    "overwrite",
    "options": { "checkpoint": "true" }
  }
}
