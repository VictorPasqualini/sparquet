{
  "name": "cessoes_base",
  "description": "Monta a base de cessões pendentes de registro em um único passo declarativo: filtra status elegível, join com parametrizacao, join com contratos aprovados (critérios avaliados via with_transformations), e tipo_contrato da remessa. O enriquecimento de multi_ativos, filtragem por parâmetros e anti-join de controle ficam no orquestrador Python.",

  "input": {
    "format": "delta",
    "path":   "lastros.silver_cessao"
  },

  "transformations": [
    {
      "type":    "select",
      "columns": ["id_cessao", "id_operacao"]
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_cessoes_status" },
      "with_transformations": [
        { "type": "filter", "condition": "status IN (1, 10, 11)" }
      ],
      "on":  "id_cessao",
      "how": "leftsemi"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_parametrizacao_registro_lastro" },
      "on":   "id_operacao",
      "how":  "inner"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.silver_contrato" },
      "with_transformations": [
        {
          "type": "join",
          "with": { "format": "delta", "path": "lastros.silver_status_criterios_contratos" },
          "on":   ["id_cessao", "id_operacao", "numero_contrato"],
          "how":  "left"
        },
        {
          "type":       "with_column",
          "name":       "status_criterio_contrato",
          "expression": "CASE WHEN status_criterio IS NULL THEN TRUE ELSE status_criterio END"
        },
        {
          "type": "group_by",
          "by":   ["id_cessao", "id_operacao", "numero_contrato", "data_referencia"],
          "agg":  [
            { "func": "min", "column": "status_criterio_contrato", "alias": "status_criterio_contrato" }
          ]
        },
        {
          "type":      "filter",
          "condition": "status_criterio_contrato = TRUE"
        },
        {
          "type":    "select",
          "columns": ["id_cessao", "numero_contrato", "data_referencia"]
        }
      ],
      "on":  "id_cessao",
      "how": "inner"
    },

    {
      "type": "join",
      "with": { "format": "delta", "path": "lastros.bronze_remessa" },
      "with_transformations": [
        { "type": "select", "columns": ["id_cessao", "tipo_contrato"] }
      ],
      "on":  "id_cessao",
      "how": "left"
    }
  ],

  "output": {
    "format": "view",
    "path":   "cessoes_base",
    "mode":   "overwrite",
    "options": { "cache": "false" }
  }
}
