{
  "name": "cessoes_CPR",
  "description": "Processa cessoes do tipo CPR: gera payload JSON, publica no Kafka e grava monitoramento no Delta.",

  "input": {
    "format": "view",
    "path":   "cessoes_para_processar"
  },

  "transformations": [
    {
      "type":      "filter",
      "condition": "tipo_ativo = 'CPR'"
    },
    {
      "type":       "with_column",
      "name":       "payload",
      "expression": "to_json(struct(cessao_id, operacao_id, cedente_cnpj, valor_face, valor_presente, produto_agricola, quantidade_produto, unidade_medida, data_emissao, data_vencimento, codigo_cpr))"
    },
    {
      "type":       "with_column",
      "name":       "header",
      "expression": "concat('CPR-', cessao_id)"
    }
  ],

  "outputs": [
    {
      "format":  "kafka",
      "path":    "cessoes-processadas",
      "mode":    "append",
      "columns": ["header", "payload"],
      "options": {
        "bootstrap_servers": "BROKER1:9092,BROKER2:9092",
        "value_column":      "payload",
        "key_column":        "header"
      }
    },
    {
      "format":  "delta",
      "path":    "MEU_CATALOG.MEU_SCHEMA.cessoes_monitoramento",
      "mode":    "append",
      "columns": ["cessao_id", "operacao_id", "tipo_ativo", "cedente_nome", "produto_agricola", "valor_face", "data_vencimento", "payload", "ingestion_ts"]
    }
  ]
}
