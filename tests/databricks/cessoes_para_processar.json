{
  "name": "cessoes_para_processar",
  "description": "A partir de cessoes_base, aplica filtros de lista e — quando processar_pendentes for verdadeiro — descarta cessões já registradas via anti-join. Recebe params com: processar_pendentes (bool), lista_contratos, lista_cessoes, lista_operacoes (listas, auto-skip se vazias).",

  "input": {
    "format": "view",
    "path":   "cessoes_base"
  },

  "transformations": [
    {
      "type":          "filter",
      "skip_if_false": "{lista_contratos}",
      "condition":     "numero_contrato IN ({lista_contratos})"
    },
    {
      "type":          "filter",
      "skip_if_false": "{lista_cessoes}",
      "condition":     "id_cessao IN ({lista_cessoes})"
    },
    {
      "type":          "filter",
      "skip_if_false": "{lista_operacoes}",
      "condition":     "id_operacao IN ({lista_operacoes})"
    },
    {
      "type":           "join",
      "skip_if_false":  "{processar_pendentes}",
      "with":           { "format": "delta", "path": "lastros.silver_controle_registro_cessoes" },
      "with_transformations": [
        { "type": "select", "columns": ["id_cessao"] }
      ],
      "on":  "id_cessao",
      "how": "leftanti"
    }
  ],

  "output": {
    "format": "view",
    "path":   "cessoes_para_processar",
    "mode":   "overwrite",
    "options": { "cache": "false" }
  }
}
