{
  "name": "cessoes_join_e_cache",
  "description": "Join das tabelas de cessoes, operacoes, cedentes e sacados. Resultado cacheado como temp view para reuso no loop por tipo de ativo.",

  "input": {
    "format": "delta",
    "path": "MEU_CATALOG.MEU_SCHEMA.cessoes"
  },

  "transformations": [
    {
      "type": "filter",
      "condition": "status_processamento = 'PENDENTE'"
    },
    {
      "type": "join",
      "with": { "format": "delta", "path": "MEU_CATALOG.MEU_SCHEMA.operacoes" },
      "on":   "operacao_id",
      "how":  "inner"
    },
    {
      "type": "join",
      "with": { "format": "delta", "path": "MEU_CATALOG.MEU_SCHEMA.cedentes" },
      "on":   "cedente_id",
      "how":  "left"
    },
    {
      "type": "join",
      "with": { "format": "delta", "path": "MEU_CATALOG.MEU_SCHEMA.sacados" },
      "on":   "sacado_id",
      "how":  "left"
    },
    {
      "type": "cast",
      "columns": { "valor_face": "double", "valor_presente": "double" }
    },
    {
      "type": "drop_duplicates",
      "columns": ["cessao_id"]
    }
  ],

  "validations": {
    "on_failure": "fail",
    "rules": [
      { "type": "not_null",  "columns": ["cessao_id", "tipo_ativo", "operacao_id"] },
      { "type": "row_count", "min": 1 }
    ]
  },

  "output": {
    "format": "view",
    "path":   "cessoes_para_processar",
    "mode":   "overwrite",
    "options": { "cache": "true" }
  }
}
