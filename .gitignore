# Build / packaging
dist/
build/
*.egg-info/
*.whl
*.tar.gz

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.venv312/
venv/
env/

# IDEs
.idea/
.vscode/
*.swp

# Spark / Hadoop
derby.log
metastore_db/

# Tests output
tests/parquet/
tests/csv/orders_export/

# claude
.claude/*

# testes
output

# Grafo de conhecimento gerado (rebuild: python -m graphify extract . --code-only)
graphify-out/

# Frontend
node_modules/
sparquet-studio/dist/

# Histórico de execuções do Studio (SQLite local, gerado em runtime)
sparquet-studio/server/data/

# Saidas de verificacao end-to-end (Spark grava part files + _SUCCESS + .crc)
.tmp_*/
examples/output/

# Scripts descartaveis de depuracao na raiz (_rep.py, _bench.py...). Escopado com "/"
# para nao pegar modulos internos legitimos como sparquet/io/_formats.py.
/_*.py
/_*.mjs

# Metastore que o Spark cria sozinho em master local (spark.sql.warehouse.dir
# default). E cache de execucao, nao fonte: se apagar, o Spark recria.
spark-warehouse/

# Biblioteca do Studio. O produto nao escreve dentro do proprio codigo-fonte: o
# default agora e o diretorio de dados do usuario (%APPDATA%\Sparquet no Windows,
# $XDG_DATA_HOME/sparquet no resto), e a pasta abaixo so sobrevive como local
# antigo, adotado automaticamente por quem ja tinha uma biblioteca ali.
sparquet-workspace/

# Dados de cobertura: o job `test` do CI roda cada arquivo num processo e o
# coverage grava um `.coverage.<host>.<pid>` por processo, combinados depois.
# Medicao, nao fonte.
.coverage
.coverage.*
htmlcov/
